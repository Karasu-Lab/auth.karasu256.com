{
  "buildCommand": "cd ../.. && pnpm turbo build --filter=auth.karasu256.com",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "build": {
    "env": {
      "ENABLE_EXPERIMENTAL_COREPACK": "1"
    }
  },
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "dev": true,
      "feat/**": true,
      "fix/**": true,
      "claude/**": true,
      "chore/**": true,
      "docs/**": true,
      "refactor/**": true
    }
  }
}
