# URL of the main karasu256.com app (used for the terms of service link)
NEXT_PUBLIC_APP_URL=

# URL of accounts.karasu256.com, the default destination after sign-in
NEXT_PUBLIC_ACCOUNTS_URL=

# Must match accounts.karasu256.com's INTERNAL_API_SECRET, which it sends to issue API keys
INTERNAL_API_SECRET=

# Used by the Neon Auth bridge (see packages/db/src/neon-auth.ts)
AUTH_SECRET=

# better-auth — hosts sign-in, passkeys, API key verification and the OAuth/OIDC authorization server.
# Generate BETTER_AUTH_SECRET with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK (server-side only — never expose to the client)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Cross-subdomain session sharing (optional)
# When set, the session cookie Domain is scoped to .{BASE_DOMAIN} so it is
# shared across all subdomains (e.g. accounts.example.com, auth.example.com).
# Leave empty for localhost / single-domain deployments.
BASE_DOMAIN=

# Resend — used to send password-reset emails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# PostgreSQL — the database owned by accounts.karasu256.com
DATABASE_URL=

# Third-party OAuth provider credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Neon Auth
# Retrieve NEON_AUTH_BASE_URL and NEON_AUTH_JWKS_URL from: neonctl neon-auth status
# Generate NEON_AUTH_COOKIE_SECRET with: openssl rand -base64 32  (must be 32+ chars)
# Generate NEON_AUTH_BRIDGE_SECRET with: openssl rand -base64 32
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_COOKIE_SECRET=
NEON_AUTH_BRIDGE_SECRET=

# Vercel Feature Flags
FLAGS_SECRET=
