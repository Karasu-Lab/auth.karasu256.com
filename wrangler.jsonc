{
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "preview": {
      "name": "auth-karasu256-com",
      "vars": {
        "APP_ENV": "preview",
        "ACCOUNTS_URL": "https://dev.accounts.karasu256.com",
        "APP_URL": "https://dev.karasu256.com",
        "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
        "CDN_URL": "https://dev.cdn.karasu256.com",
        "TRUSTED_ORIGINS": "https://dev.accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev.karasu256.com,https://dev.qr.karasu256.com",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
      }
    }
  },
  "main": ".open-next/worker.js",
  "name": "auth-karasu256-com",
  "vars": {
    "APP_ENV": "production",
    "ACCOUNTS_URL": "https://accounts.karasu256.com",
    "APP_URL": "https://karasu256.com",
    "AUTH_API_URL": "https://api-auth.karasu256.com",
    "CDN_URL": "https://cdn.karasu256.com",
    "TRUSTED_ORIGINS": "https://accounts.karasu256.com,https://auth.karasu256.com,https://karasu256.com,https://qr.karasu256.com",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
  },
  "previews": {
    "vars": {
      "APP_ENV": "preview",
      "ACCOUNTS_URL": "https://dev.accounts.karasu256.com",
      "APP_URL": "https://dev.karasu256.com",
      "AUTH_API_URL": "https://dev-api-auth.karasu256.com",
      "CDN_URL": "https://dev.cdn.karasu256.com",
      "TRUSTED_ORIGINS": "https://dev.accounts.karasu256.com,https://dev-auth.karasu256.com,https://dev.karasu256.com,https://dev.qr.karasu256.com",
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFsX0TpFOyokXFPm"
    }
  }
}
