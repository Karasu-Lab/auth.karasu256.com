{
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "compatibility_date": "2025-06-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "dev": {
      "name": "dev-auth-karasu256-com",
      "vars": {
        "TRUSTED_ORIGINS": "https://dev-auth.karasu256.com,https://dev-sso.karasu256.com,https://dev.karasu256.com,https://dev.qr.karasu256.com,https://*-accounts-karasu256-com.*.workers.dev"
      },
      "routes": [
        {
          "pattern": "dev-auth.karasu256.com",
          "custom_domain": true
        }
      ]
    }
  },
  "main": ".open-next/worker.js",
  "name": "auth-karasu256-com"
}
